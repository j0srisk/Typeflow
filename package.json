{
  "name": "flowscript",
  "version": "1.0.0",
  "description": "Local dev tool for modular TypeScript+CSS workflow with Webflow.",
  "type": "module",
  "main": "build.js",
  "bin": {
    "flowscript": "dist/index.js"
  },
  "scripts": {
