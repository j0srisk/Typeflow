{
  "name": "typeflow",
  "version": "1.6.0",
  "description": "Local development server for TypeScript/JavaScript and CSS files in Webflow projects",
  "main": "dist/index.js",
  "bin": {
    "typeflow": "./bin/typeflow.js"
  },
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "esbuild src/client/main.ts --outfile=dist/client/main.js --target=es2020 && cp src/client/index.html src/client/index.css dist/client/",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "webflow",
    "typescript",
    "development",
    "esbuild",
    "live-reload"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/",
    "bin/"
  ],
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "esbuild": "^0.25.8",
    "ms": "^2.1.3",
    "picocolors": "^1.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
